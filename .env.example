# Copy to .env.local and fill in. On Railway, set these in the service variables.
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/grit
# Any string >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars
APP_TZ=Asia/Kolkata
# Clock, story and tick demo tools. Defaults: on in development, off in production.
DEV_TOOLS_ENABLED=true
# Production only: enables the persona switcher at /start. It is PRINTED on /start
# (demo opt-in, not access control). Unset = nobody can sign in to a production deploy.
DEMO_PASSCODE=
# Bearer secret for POST /api/v1/jobs/tick (cron) and /api/v1/integrations/*.
CRON_SECRET=
